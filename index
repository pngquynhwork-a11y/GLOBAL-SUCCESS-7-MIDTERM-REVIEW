      <p class="text-stone-600 text-base mb-6" id="modal-unanswered-text">Bạn có chắc chắn muốn nộp bài thi để xem điểm và lời giải chi tiết?</p>
      
      <div class="flex justify-center gap-3">
        <button onclick="closeConfirmModal()" class="px-5 py-2.5 bg-stone-200 hover:bg-stone-300 text-stone-800 font-semibold rounded-lg transition">
          Tiếp tục làm bài
        </button>
        <button onclick="submitExam()" class="px-6 py-2.5 bg-green-700 hover:bg-green-800 text-white font-bold rounded-lg shadow transition">
          Đồng ý nộp bài
        </button>
      </div>
    </div>
  </div>

  <!-- ==================== SCRIPT XỬ LÝ TOÀN BỘ ==================== -->
  <script>
    // Dữ liệu đáp án & lời giải chi tiết
    const EXAM_DATA = {
