        explain: "Biển báo ghi rõ: 'PLEASE TURN OFF ALL LIGHTS BEFORE LEAVING' -> Hãy tắt tất cả đèn trước khi rời khỏi phòng học."
      },
      18: {
        type: "choice",
        correct: "B",
        label: "Do not park your vehicle in this area.",
        explain: "Biển báo chữ P bị gạch chéo kèm dòng chữ 'NO PARKING IN THIS AREA' có nghĩa là cấm đỗ xe trong khu vực này."
      },
      19: {
        type: "choice",
        correct: "B",
        label: "healthy",
        explain: "Từ 'fit' trong 'stay fit and strong' có nghĩa là khỏe mạnh, cân đối. Từ gần nghĩa nhất là 'healthy'."
      },
      20: {
        type: "choice",
        correct: "C",
        label: "wholesome",
        explain: "'unhealthy' có nghĩa là không lành mạnh, có hại cho sức khỏe. Từ trái nghĩa là 'wholesome' (lành mạnh, tốt cho sức khỏe)."
      },
      21: {
        type: "choice",
        correct: "A",
        label: "making",
        explain: "Cụm cố định: 'make crafts' (làm đồ thủ công). Cấu trúc song song dạng V-ing: collecting, playing, or making crafts."
      },
      22: {
        type: "choice",
        correct: "A",
        label: "However",
        explain: "Câu trước nói về sở thích làm đồ tái chế rất rẻ, câu sau nói làm nhà búp bê tốn nhiều thời gian và tiền mua đồ. Hai câu mang ý tương phản -> dùng 'However' (Tuy nhiên)."
      },
      23: {
        type: "choice",
        correct: "A",
        label: "benefits",
        explain: "Cụm từ: 'bring you many benefits' (mang lại nhiều lợi ích), rất phù hợp với câu tiếp theo đang liệt kê các lợi ích của sở thích."
      },
      24: {
        type: "choice",
        correct: "A",
        label: "develop",
        explain: "Cụm từ: 'develop your creativity' (phát triển sự sáng tạo của bạn)."
      },
      25: {
        type: "choice",
        correct: "A",
        label: "confident",
        explain: "Sau động từ liên kết 'feel' và 'more' cần một tính từ: 'confident' (tự tin)."
      },
      26: {
        type: "choice",
        correct: "B",
        label: "Health problems in teenagers and advice for a healthy lifestyle",
        explain: "Đoạn 1 nêu các vấn đề sức khỏe của thiếu niên (đồ ăn nhanh, ít vận động); Đoạn 2 nêu lời khuyên của bác sĩ để có lối sống lành mạnh."
      },
      27: {
        type: "choice",
        correct: "A",
        label: "More than 30%",
        explain: "Thông tin trong bài: 'A recent survey shows that more than 30% of secondary school students eat fast food at least three times a week.'"
      },
      28: {
        type: "choice",
        correct: "B",
        label: "It contains a lot of fat, salt, and sugar.",
        explain: "Thông tin trong bài: 'Fast food contains a lot of fat, salt, and sugar, which can lead to overweight and obesity.'"
      },
      29: {
        type: "choice",
        correct: "B",
        label: "teenagers",
        explain: "Trong câu: 'doctors suggest that teenagers should change their daily routines. First, they should replace...', đại từ 'they' thay thế cho danh từ 'teenagers' đi trước."
      },
      30: {
        type: "choice",
        correct: "C",
        label: "Spending hours playing video games every day",
        explain: "Bác sĩ khuyên ăn rau quả, uống nước lọc, tập thể dục 30 phút mỗi ngày. Việc 'Dành hàng giờ chơi trò chơi điện tử' không phải là lời khuyên có lợi."
      },
      31: {
        type: "choice",
        correct: "B",
        label: "to cook",
        explain: "Sau 'enjoy' phải dùng V-ing: enjoy + cooking. Sửa 'to cook' thành 'cooking'."
      },
      32: {
        type: "choice",
        correct: "A",
        label: "collect",
        explain: "Có trạng từ chỉ thời gian 'Last week' (quá khứ đơn), động từ 'collect' cần chia quá khứ là 'collected'."
      },
      33: {
        type: "choice",
        correct: "C",
        label: "are",
        explain: "Danh động từ 'Eating too much candy' làm chủ ngữ số ít, nên động từ to be phải chia là 'is' thay vì 'are'."
      },
      34: {
        type: "choice",
        correct: "B",
        label: "many",
        explain: "'water' là danh từ không đếm được nên dùng lượng từ 'much', không dùng 'many'. Sửa 'many' thành 'much'."
      },
      35: {
        type: "text",
        prompt: "➜ Mai's pens ",
        acceptRegex: /^are\s+on\s+the\s+bookshelf\.?$/i,
        correctFull: "Mai's pens are on the bookshelf.",
        modelText: "are on the bookshelf.",
        explain: "Gộp hai vế 'These are Mai's pens and they are on the bookshelf' thành một câu hoàn chỉnh: Mai's pens are on the bookshelf."
      },
      36: {
        type: "text",
        prompt: "➜ My father's hobby ",
        acceptRegex: /^is\s+collecting\s+old\s+stamps\.?$/i,
        correctFull: "My father's hobby is collecting old stamps.",
        modelText: "is collecting old stamps.",
        explain: "Cấu trúc: 'find doing something + adj' tương đương với '(one's) hobby is + V-ing': My father's hobby is collecting old stamps."
      },
      37: {
        type: "text",
        prompt: "➜ Because Minh ",
        acceptRegex: /^was\s+lazy,\s*he\s+failed\s+the\s+english\s+test\s+last\s+week\.?$/i,
        correctFull: "Because Minh was lazy, he failed the English test last week.",
        modelText: "was lazy, he failed the English test last week.",
        explain: "Câu gốc dùng 'so' chỉ kết quả: 'Minh was lazy, so he failed...'. Chuyển sang mệnh đề 'Because': Because Minh was lazy, he failed the English test last week."
      },
      38: {
        type: "text",
        prompt: "➜ Nam ",
        acceptRegex: /^usually\s+plays\s+football\s+with\s+his\s+friends\s+after\s+school\.?$/i,
        correctFull: "Nam usually plays football with his friends after school.",
        modelText: "usually plays football with his friends after school.",
        explain: "Trật tự câu: Chủ ngữ (Nam) + Trạng từ tần suất (usually) + Động từ (plays) + Tân ngữ (football) + with his friends + after school."
      },
      39: {
        type: "text",
        prompt: "➜ We ",
        acceptRegex: /^planted\s+50\s+new\s+trees\s+in\s+the\s+school\s+garden\s+last\s+month\.?$/i,
        correctFull: "We planted 50 new trees in the school garden last month.",
        modelText: "planted 50 new trees in the school garden last month.",
        explain: "Trật tự câu: Chủ ngữ (We) + Động từ quá khứ (planted) + Tân ngữ (50 new trees) + Nơi chốn (in the school garden) + Thời gian (last month)."
      },
      40: {
        type: "text",
        prompt: "➜ Drinking ",
        acceptRegex: /^enough\s+water\s+keeps\s+your\s+body\s+healthy\s+and\s+hydrated\.?$/i,
        correctFull: "Drinking enough water keeps your body healthy and hydrated.",
        modelText: "enough water keeps your body healthy and hydrated.",
        explain: "Trật tự câu: Cụm V-ing làm chủ ngữ (Drinking enough water) + Động từ (keeps) + Tân ngữ (your body) + Tính từ (healthy and hydrated)."
      }
    };

    // Quản lý trạng thái
    let studentName = "";
    let studentClass = "";
    let timerInterval = null;
    let totalSeconds = 60 * 60; // 60 phút
    let timeElapsed = 0;

    function startExam() {
      const nameInput = document.getElementById("student-name").value.trim();
      const classInput = document.getElementById("student-class").value.trim();
      const errorMsg = document.getElementById("start-error");

      if (!nameInput || !classInput) {
        errorMsg.classList.remove("hidden");
        return;
      }
      errorMsg.classList.add("hidden");

      studentName = nameInput;
      studentClass = classInput;

      // Cập nhật header
      document.getElementById("header-student-info").textContent = `Học sinh: ${studentName} | Lớp: ${studentClass}`;

      // Chuyển màn hình
      document.getElementById("start-screen").classList.add("hidden");
      document.getElementById("exam-header").classList.remove("hidden");
      document.getElementById("exam-main").classList.remove("hidden");

      window.scrollTo({ top: 0, behavior: 'smooth' });

      // Chạy đồng hồ
      timerInterval = setInterval(updateTimer, 1000);
    }

    function updateTimer() {
      if (totalSeconds <= 0) {
        clearInterval(timerInterval);
        submitExam(true); // tự động nộp bài khi hết giờ
        return;
      }
      totalSeconds--;
      timeElapsed++;

      const mins = Math.floor(totalSeconds / 60);
      const secs = totalSeconds % 60;
      const display = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
      
      const timerEl = document.getElementById("timer-display");
      timerEl.textContent = display;

      if (totalSeconds < 300) { // < 5 phút
        timerEl.classList.add("animate-bounce");
      }
    }

    function openConfirmModal() {
      // Đếm số câu chưa làm
      let unanswered = 0;
      for (let i = 9; i <= 34; i++) {
        const checked = document.querySelector(`input[name="q${i}"]:checked`);
        if (!checked) unanswered++;
      }
      for (let i = 35; i <= 40; i++) {
        const val = document.getElementById(`q${i}`).value.trim();
        if (!val) unanswered++;
      }

      const textEl = document.getElementById("modal-unanswered-text");
      if (unanswered > 0) {
        textEl.innerHTML = `Bạn còn <strong class="text-red-600">${unanswered} câu chưa hoàn thành</strong>.<br>Bạn có chắc chắn muốn nộp bài ngay bây giờ?`;
      } else {
        textEl.innerHTML = "Bạn đã hoàn thành tất cả các câu hỏi!<br>Bạn có chắc chắn muốn nộp bài để xem điểm số?";
      }

      document.getElementById("confirm-modal").classList.remove("hidden");
    }

    function closeConfirmModal() {
      document.getElementById("confirm-modal").classList.add("hidden");
    }

    function cleanString(str) {
      return str.trim().replace(/\s+/g, ' ').toLowerCase();
    }

    function submitExam(isAuto = false) {
      if (timerInterval) clearInterval(timerInterval);
      closeConfirmModal();

      let correctCount = 0;
      const totalQuestions = 32;
      const reviewContainer = document.getElementById("review-list");
      reviewContainer.innerHTML = "";

      // Thu thập câu trả lời và chấm điểm
      for (let q = 9; q <= 40; q++) {
        const qData = EXAM_DATA[q];
        let isCorrect = false;
        let studentAnswerText = "";

        if (qData.type === "choice") {
          const selectedRadio = document.querySelector(`input[name="q${q}"]:checked`);
          const ans = selectedRadio ? selectedRadio.value : "";
          isCorrect = (ans === qData.correct);
          studentAnswerText = ans ? `Phương án ${ans}` : "(Chưa chọn)";
        } else {
          // Tự luận
          const inputVal = document.getElementById(`q${q}`).value.trim();
          studentAnswerText = inputVal ? inputVal : "(Chưa nhập)";
          // Kiểm tra Regex hoặc exact
          const cleaned = cleanString(inputVal);
          isCorrect = qData.acceptRegex.test(cleaned);
        }

        if (isCorrect) correctCount++;

        // Tạo thẻ đánh giá chi tiết
        const card = document.createElement("div");
        card.className = `p-5 rounded-xl border ${isCorrect ? 'bg-emerald-50/70 border-emerald-300' : 'bg-red-50/70 border-red-300'} transition`;

        let headerBadge = isCorrect 
          ? `<span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800">✓ ĐÚNG</span>` 
          : `<span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-red-100 text-red-800">✕ SAI</span>`;

        let questionPrompt = "";
        let correctDisplay = "";

        if (qData.type === "choice") {
          correctDisplay = `<strong>${qData.correct}</strong> ${qData.label ? `(${qData.label})` : ''}`;
        } else {
          correctDisplay = `<div class="mt-1 font-mono text-emerald-900 bg-emerald-100/60 p-2 rounded">
            <strong>Câu đầy đủ:</strong> ${qData.correctFull}<br>
            <strong>Phần viết tiếp:</strong> ${qData.modelText}
          </div>`;
        }

        card.innerHTML = `
          <div class="flex items-center justify-between mb-2">
            <h4 class="font-bold text-stone-900 text-lg">Câu ${q}:</h4>
            ${headerBadge}
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-base mb-3 text-justify-custom">
            <p><span class="font-semibold text-stone-600">Câu trả lời của bạn:</span> <span class="${isCorrect ? 'text-emerald-700 font-bold' : 'text-red-700 font-bold'}">${studentAnswerText}</span></p>
            <div><span class="font-semibold text-stone-600">Đáp án chính xác:</span> ${correctDisplay}</div>
          </div>
          <div class="bg-white/80 p-3 rounded-lg border border-stone-200 text-sm sm:text-base text-stone-800 text-justify-custom">
            <strong class="text-blue-900">💡 Lời giải chi tiết:</strong> ${qData.explain}
          </div>
        `;

        reviewContainer.appendChild(card);
      }

      // Tính điểm thang 10
      const score10 = ((correctCount / totalQuestions) * 10).toFixed(2);
      const minutesSpent = Math.floor(timeElapsed / 60);
      const secondsSpent = timeElapsed % 60;

      // Cập nhật màn hình kết quả
      document.getElementById("res-student-info").textContent = `Học sinh: ${studentName} | Lớp: ${studentClass}`;
      document.getElementById("res-time-spent").textContent = `${minutesSpent} phút ${secondsSpent} giây`;
      document.getElementById("res-correct-count").textContent = `${correctCount} / ${totalQuestions} câu`;
      document.getElementById("res-score-10").textContent = score10;

      // Ẩn exam, mở result
      document.getElementById("exam-header").classList.add("hidden");
      document.getElementById("exam-main").classList.add("hidden");
      document.getElementById("result-screen").classList.remove("hidden");

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function retakeExam() {
      // Reset form
      document.getElementById("quiz-form").reset();
      for (let i = 35; i <= 40; i++) {
        document.getElementById(`q${i}`).value = "";
      }
      totalSeconds = 60 * 60;
      timeElapsed = 0;
      document.getElementById("timer-display").textContent = "60:00";
      document.getElementById("timer-display").classList.remove("animate-bounce");

      document.getElementById("result-screen").classList.add("hidden");
      document.getElementById("start-screen").classList.remove("hidden");
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  </script>
</body>
</html>
